SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
INVITE_REDIRECT_BASE=weekpact://invite

# RevenueCat public SDK keys (Project settings -> API keys).
# REVENUECAT_TEST_KEY routes purchases to the Test Store for local work and is
# ignored by release builds; the SDK crashes a release build configured with it.
REVENUECAT_APPLE_KEY=appl_YOUR_KEY
REVENUECAT_TEST_KEY=test_YOUR_KEY

# The numeric Apple ID from App Store Connect (App Information), so the update
# prompt opens WeekPact's App Store page. Without it iOS opens a store search.
APP_STORE_ID=

# Optional overrides after publishing the website:
# TERMS_URL defaults to Apple's standard EULA, which the paywall must link to.
APP_SITE_URL=https://weekpact.codepeaktrail.dev
PRIVACY_URL=https://weekpact.codepeaktrail.dev/privacy/
SUPPORT_URL=https://weekpact.codepeaktrail.dev/support/

# Google sign-in. The web client is the one Supabase verifies tokens against
# (Android asks for tokens on its behalf); the iOS client must match GIDClientID
# and the reversed URL scheme in ios/Runner/Info.plist. Both are public IDs.
GOOGLE_WEB_CLIENT_ID=705377133061-bu9bmehie9rnr19893854eoetlkr9p9o.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=705377133061-ls6gpj0ssehgbvhbcgbif5gt5gd3qtqc.apps.googleusercontent.com
