SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
APP_TIMEZONE=Europe/Sarajevo
INVITE_REDIRECT_BASE=weekpact://invite

# RevenueCat public SDK keys (Project settings -> API keys).
# REVENUECAT_TEST_KEY routes purchases to the Test Store for local work and is
# ignored by release builds; the SDK crashes a release build configured with it.
REVENUECAT_APPLE_KEY=appl_YOUR_KEY
REVENUECAT_TEST_KEY=test_YOUR_KEY

# Optional overrides after publishing the website:
# TERMS_URL defaults to Apple's standard EULA, which the paywall must link to.
APP_SITE_URL=https://weekpact.codepeaktrail.dev
PRIVACY_URL=https://weekpact.codepeaktrail.dev/privacy/
SUPPORT_URL=https://weekpact.codepeaktrail.dev/support/
