# Sign in with Apple: lets apple-token store refresh tokens and delete-account
# revoke them. From developer.apple.com → Certificates, IDs & Profiles → Keys.
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_SIGN_IN_WITH_APPLE_KEY_ID
APPLE_CLIENT_ID=dev.codepeaktrail.weekpact
# The .p8 contents; literal \n separators are accepted on one line.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
ALLOWED_ORIGIN=*
