AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# Optional for temporary AWS credentials; rotate before they expire:
# AWS_SESSION_TOKEN=YOUR_AWS_SESSION_TOKEN
# Optional SES configuration set in the same region:
# SES_CONFIGURATION_SET=crew-invites
EMAIL_FROM=WeekPact <invites@YOUR_VERIFIED_DOMAIN.com>
APP_BASE_URL=weekpact://invite
# After the website domain resolves and /invite/ is hosted, use:
# APP_BASE_URL=https://weekpact.codepeaktrail.dev/invite/
ALLOWED_ORIGIN=*
