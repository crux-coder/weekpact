SITE_URL=https://weekpact.codepeaktrail.dev
# Optional; leave empty until a real distribution link exists.
PUBLIC_IOS_INSTALL_URL=
PUBLIC_ANDROID_INSTALL_URL=
# Full Apple application identifier: prefix.bundleIdentifier, not the numeric App Store ID.
# Optional; empty uses the current project's identifier below.
IOS_APP_ID=R5L8RZTV6R.dev.codepeaktrail.weekpact
# Android App Links verification is generated only when both values are set.
ANDROID_PACKAGE_NAME=com.example.keepup
# Comma-separated SHA-256 signing-certificate fingerprints, each colon-separated.
ANDROID_SHA256_CERT_FINGERPRINTS=
