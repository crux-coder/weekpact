---
import '../styles/global.css';
import { readSiteConfig } from '../lib/config.mjs';
interface Props { title: string; description: string; privatePage?: boolean; home?: boolean; dark?: boolean; }
const { title, description, privatePage = false, home = false, dark = false } = Astro.props;
const config = readSiteConfig();
const canonical = new URL(Astro.url.pathname, config.siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content={home || dark ? "#191B19" : "#F7F3E9"} />
    {privatePage && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <link rel="preload" href="/fonts/RobotoCondensed-Bold.ttf" as="font" type="font/ttf" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="WeekPact" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${config.siteUrl}/app-icon.png`} />
    <meta property="og:image:alt" content="WeekPact app icon" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body class:list={{'handoff-theme': dark}}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href="/" aria-label="WeekPact home"><img src="/app-icon.png" width="40" height="40" alt="" /><span>WeekPact.</span></a>
      <nav aria-label="Main navigation">
        {home ? <><a href="#how-it-works">How it works</a><a class="nav-cta" href="/open/">Open WeekPact ↗</a></> : <a href="/">Back to home</a>}
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container footer-content"><a class="wordmark" href="/"><img src="/app-icon.png" width="40" height="40" alt="" /><span>WeekPact.</span></a><nav aria-label="Help and privacy"><a href="/privacy/">Privacy</a><a href="/support/">Support</a></nav><p>Good habits. Great company.</p></div>
    </footer>
  </body>
</html>
