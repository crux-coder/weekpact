---
import SiteLayout from '../layouts/SiteLayout.astro';
import HugeIcon from '../components/HugeIcon.astro';
---
<SiteLayout title="Page not found — WeekPact" description="Return to WeekPact or find your crew invitation." privatePage tint="var(--coral)">
  <main id="main" class="container not-found">
    <section class="surface surface--card" style="--fill:var(--coral)">
      <h1>A little off track<span class="dot" style="color:var(--ink)">.</span></h1>
      <p>This page doesn’t exist. Let’s get you back to your crew.</p>
      <div class="actions">
        <a class="button" href="/">Back to home <HugeIcon name="arrowRight01" size={20} /></a>
        <a class="text-link" href="/invite/">Looking for an invitation?</a>
      </div>
    </section>
  </main>
</SiteLayout>
