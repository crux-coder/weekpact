---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
---
<SiteLayout home title="WeekPact — Good habits. Great company." description="Make a weekly pact with your people. Set shared goals, check in together, and build a crew streak with WeekPact.">
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Good habits.<br /><span>Great company.</span></h1>
        <p class="lead">Make a weekly pact with your people. Pick your goals, check in, and keep showing up together.</p>
        <div class="hero-actions"><a class="button" href="/open/">Open WeekPact <Arrow /></a><a class="text-link" href="#how-it-works">How it works</a></div>
      </div>
      <div class="preview" aria-label="Example of a WeekPact crew's weekly goals">
        <span class="attached-tab">YOUR WEEK</span>
        <div class="preview-card">
          <div class="preview-heading"><h2>Early Birds</h2><span>EXAMPLE CREW</span></div>
          <div class="goal-row">
            <div class="goal-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="4" r="2"/><path d="m7 11 4-3 4 1 3 4m-7-5-1 7-4 6m4-6 5 2 2 4M7 11l-1 4"/></svg></div>
            <div class="goal-copy"><h3>Move for 30 minutes</h3><div class="dots" aria-label="Five of seven days completed">{Array.from({length: 7}, (_, i) => <span class:list={{ done: i < 5 }} />)}</div></div>
            <span class="example-checkbox" aria-hidden="true"></span>
          </div>
          <div class="goal-row">
            <div class="goal-icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 5c-3-2-6-2-10-1v15c4-1 7-1 10 1 3-2 6-2 10-1V4c-4-1-7-1-10 1Zm0 0v15"/></svg></div>
            <div class="goal-copy"><h3>Read 20 pages</h3><div class="dots" aria-label="Two of three days completed">{Array.from({length: 3}, (_, i) => <span class:list={{ done: i < 2 }} />)}</div></div>
            <span class="example-checkbox" aria-hidden="true"></span>
          </div>
        </div>
        <p class="preview-caption">Small steps. Shared wins.</p>
      </div>
    </section>
    <section class="how-section" id="how-it-works" aria-labelledby="how-title">
      <div class="container"><h2 id="how-title">A little pact. A better week.</h2>
        <ol class="steps">
          <li><span class="step-number">01</span><h3>Find your crew</h3><p>Invite the people you want to show up with.</p></li>
          <li><span class="step-number">02</span><h3>Pick your goals</h3><p>Choose every day or a few days each week.</p></li>
          <li><span class="step-number">03</span><h3>Keep showing up</h3><p>Check in together and build a shared streak.</p></li>
        </ol>
      </div>
    </section>
  </main>
</SiteLayout>
<script>
  // Older link configurations may point at the root. Keep the token intact.
  const params = new URLSearchParams(location.search);
  if (params.has('invite')) location.replace(`/invite/${location.search}`);
</script>
