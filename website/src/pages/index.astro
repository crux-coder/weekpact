---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../styles/home.css';
---
<SiteLayout home title="WeekPact — Good habits. Great company." description="Make a weekly pact with your people. Check in, cheer each other on, and keep showing up together.">
  <main id="main">
    <section class="launch-hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Good habits.<br /><span>Great company.</span></h1>
        <p class="launch-lead">Make a weekly pact with your people. Check in, cheer each other on, and keep showing up together.</p>
        <div class="launch-actions"><a class="button" href="/open/">Start your crew <span aria-hidden="true">↗</span></a><a href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a></div>
        <p class="hero-caption">Small steps. Shared wins.<span></span></p>
      </div>
      <div class="phone-stage">
        <div class="iphone" aria-label="WeekPact running on an iPhone, with a fictional example crew">
          <div class="phone-screen">
            <img id="app-screen" src="/screenshots/home.png" width="1170" height="2532" alt="The current WeekPact home screen: Early Birds crew, recent check-in, crew streak, and today's pacts." fetchpriority="high" />
            <span class="phone-time" aria-hidden="true">9:41</span><span class="island" aria-hidden="true"></span><span class="phone-status" aria-hidden="true">▮▮▮ ▰</span>
          </div>
        </div>
        <div class="screen-switch" role="group" aria-label="Preview app screens">
          <button type="button" data-screen="home" aria-pressed="true">Your week</button>
          <button type="button" data-screen="crew" aria-pressed="false">Your crew</button>
        </div>
        <p class="demo-caption">Real app screens · Example crew</p>
      </div>
    </section>
    <section class="launch-how" id="how-it-works" aria-labelledby="how-title">
      <div class="container"><h2 id="how-title">A little pact. A better week.</h2>
        <ol class="launch-steps">
          <li><span>01</span><h3>Find your people</h3><p>Start a crew and invite your friends. A little company goes a long way.</p></li>
          <li><span>02</span><h3>Make it yours</h3><p>Choose a small commitment and a weekly rhythm that fits your life.</p></li>
          <li><span>03</span><h3>Show up together</h3><p>Check in, give a little encouragement, and celebrate the week you made.</p></li>
        </ol>
      </div>
    </section>
    <section class="launch-close container"><h2>Your next good week<br />starts together.</h2><p>Bring your people. Make a little progress together.</p><a class="button" href="/open/">Start your crew <span aria-hidden="true">↗</span></a></section>
  </main>
</SiteLayout>
<script>
  const params = new URLSearchParams(location.search);
  if (params.has('invite')) location.replace(`/invite/${location.search}`);
  const screen = document.querySelector<HTMLImageElement>('#app-screen');
  document.querySelectorAll<HTMLButtonElement>('[data-screen]').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-screen]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      const selected = button.dataset.screen ?? 'home';
      if (screen) {
        screen.src = `/screenshots/${selected}.png`;
        screen.alt = selected === 'crew' ? 'The expanded crew list with full names and motivating Nudge buttons.' : "The current WeekPact home screen: Early Birds crew, recent check-in, crew streak, and today's pacts.";
      }
    });
  });
</script>
