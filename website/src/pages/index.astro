---
import SiteLayout from '../layouts/SiteLayout.astro';
import HugeIcon from '../components/HugeIcon.astro';
import '../styles/home.css';

// Each feature wears a pact's colours — `pactTint(i)` for the card and
// `pactBadge(i)` for its icon — the way a pact does in the app.
const features = [
  { tint: 'var(--clay)', badge: '#cba08b', icon: 'runningShoes', title: 'One card per pact', copy: 'Each pact gets its own card on Home. Tap Check in, add a photo if the pact asks for one, and watch the week fill.' },
  { tint: 'var(--sage)', badge: '#a4c289', icon: 'camera01', title: 'See the crew’s day', copy: 'Everyone sits in a row at the top of Home. Tap a face to see what they kept, give it a clap, or nudge whoever isn’t in yet.' },
  { tint: 'var(--straw)', badge: '#d0c295', icon: 'crown', title: 'A little friendly race', copy: 'A podium shows who’s leading the week and how far everyone else has come. Your face is ringed, so you always know where you stand.' },
  { tint: 'var(--blush)', badge: '#d1999f', icon: 'bubbleChat', title: 'A chat for every crew', copy: 'Cheer the early runners, call out the stragglers, and promise you’re going at lunch. Every crew gets its own chat.' },
] as const;

const steps = [
  { icon: 'target01', title: 'Pick one small thing', copy: 'Start a crew and make a pact: a run, a few pages, ten minutes of stretching. Choose how many days a week.' },
  { icon: 'link01', title: 'Share your code', copy: 'Every crew has a six-character invite code. Send it to your friends and they’re in with one tap.' },
  { icon: 'fire', title: 'Show up together', copy: 'Check in, clap for each other, and keep the crew’s streak going week after week.' },
] as const;

// The welcome screen's hand of pact cards, drawn again in HTML.
const fan = [
  { tint: 'var(--blush)', badge: '#d1999f', icon: 'bookOpen01', title: 'Read before bed', kept: 4, of: 5 },
  { tint: 'var(--straw)', badge: '#d0c295', icon: 'yoga01', title: 'Stretch for 10 minutes', kept: 1, of: 3 },
  { tint: 'var(--sage)', badge: '#a4c289', icon: 'runningShoes', title: 'Morning run', kept: 2, of: 3 },
] as const;

const screens = {
  home: 'The WeekPact home screen for the Early Birds crew: today’s check-ins in a row of faces, the crew’s week, a podium with Lejla leading at 53%, and the Move for 30 min pact card at 2 of 7 days.',
  chat: 'The Early Birds crew chat, with crewmates trading notes about their morning runs.',
  crew: 'The Early Birds crew page: 4 people, 3 pacts and a 3-week streak, with the crew’s pacts listed below.',
};
---
<SiteLayout home title="WeekPact — Good habits. Great company." description="Pick one small thing, keep it a few days a week, and do it alongside your friends.">
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">A weekly pact with your people</p>
        <h1 id="hero-title">Good habits<span class="dot">.</span><br />Great company<span class="dot">.</span></h1>
        <p class="hero-lead">Pick one small thing, keep it a few days a week, and do it alongside your friends.</p>
        <div class="hero-actions">
          <a class="button" href="/open/">Get started</a>
          <a class="button button--ink" href="/invite/"><HugeIcon name="link01" size={18} /> I have an invite code</a>
        </div>
        <p class="hero-proof caption"><HugeIcon name="apple" size={16} /> Sign in with Apple or Google. No password to remember.</p>
      </div>
      <div class="phone-stage">
        <div class="phone" aria-label="WeekPact running on an iPhone, with a fictional example crew">
          <div class="phone-screen">
            <img id="app-screen" src="/screenshots/home.png" width="1170" height="2532" alt={screens.home} fetchpriority="high" />
            <span class="phone-time" aria-hidden="true">9:41</span><span class="island" aria-hidden="true"></span>
          </div>
        </div>
        <div class="screen-switch" role="group" aria-label="Preview app screens">
          <button type="button" data-screen="home" data-alt={screens.home} aria-pressed="true">Home</button>
          <button type="button" data-screen="chat" data-alt={screens.chat} aria-pressed="false">Chat</button>
          <button type="button" data-screen="crew" data-alt={screens.crew} aria-pressed="false">Crew</button>
        </div>
        <p class="demo-caption caption">Real app screens · Example crew</p>
      </div>
    </section>

    <section class="features container" id="inside" aria-labelledby="features-title">
      <p class="eyebrow">Inside the app</p>
      <h2 id="features-title">What a week looks like<span class="dot">.</span></h2>
      <div class="feature-grid">
        {features.map(feature => (
          <article class="surface surface--card feature" style={`--fill:${feature.tint}`}>
            <span class="icon-tile" style={`--fill:${feature.badge}`}><HugeIcon name={feature.icon} size={24} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="how container" id="how-it-works" aria-labelledby="how-title">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">Three steps<span class="dot">.</span> Then just show up<span class="dot">.</span></h2>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="surface surface--card step">
            <div class="step-head">
              <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
              <HugeIcon name={step.icon} size={24} />
            </div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
            {index === 1 && (
              <div class="code-sample" aria-label="An example invite code, 7K2QXM">
                {'7K2QXM'.split('').map(char => <span aria-hidden="true">{char}</span>)}
              </div>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="close container" aria-labelledby="close-title">
      <div class="surface surface--dark surface--card close-card">
        <div class="fan" aria-hidden="true">
          {fan.map(card => (
            <div class="pact-card" style={`--fill:${card.tint};--badge:${card.badge}`}>
              <div class="pact-card-head">
                <span class="pact-card-title">{card.title}</span>
                <span class="pact-badge"><HugeIcon name={card.icon} size={18} /></span>
              </div>
              <span class="pact-count"><b>{card.kept}</b> / {card.of} <small>days</small></span>
              <span class="pact-bars">
                {Array.from({ length: card.of }, (_, i) => <i class={i < card.kept ? 'kept' : ''}></i>)}
              </span>
            </div>
          ))}
        </div>
        <h2 id="close-title">Your next good week<br />starts together<span class="dot">.</span></h2>
        <p>Bring your people. Make a little progress together.</p>
        <a class="button" href="/open/">Get started</a>
      </div>
    </section>
  </main>
</SiteLayout>
<script>
  const params = new URLSearchParams(location.search);
  if (params.has('invite') || params.has('code')) location.replace(`/invite/${location.search}`);
  const screen = document.querySelector<HTMLImageElement>('#app-screen');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-screen]');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      if (screen) {
        screen.src = `/screenshots/${button.dataset.screen ?? 'home'}.png`;
        screen.alt = button.dataset.alt ?? '';
      }
    });
  });
</script>
