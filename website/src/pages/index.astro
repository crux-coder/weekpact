---
import SiteLayout from '../layouts/SiteLayout.astro';
import HugeIcon from '../components/HugeIcon.astro';
import '../styles/home.css';

const features = [
  { tint: 'var(--mint)', icon: 'camera01', title: 'Check in together', copy: 'A photo marks the day done. Your crew sees it, and the week fills in for everyone at once.' },
  { tint: 'var(--sky)', icon: 'fire', title: 'Build a crew streak', copy: 'Weeks you all show up stack into a streak the whole crew owns, not just you.' },
  { tint: 'var(--butter)', icon: 'handsClapping', title: 'Cheer each other on', copy: 'Clap for a check-in, nudge the people still on the fence. Small company, big difference.' },
] as const;

const steps = [
  { tint: 'var(--lemon)', icon: 'userGroup', title: 'Find your people', copy: 'Start a crew and invite your friends. A little company goes a long way.' },
  { tint: 'var(--mint)', icon: 'target01', title: 'Make it yours', copy: 'Choose a small commitment and a weekly rhythm that fits your life.' },
  { tint: 'var(--sky)', icon: 'calendar03', title: 'Show up together', copy: 'Check in, give a little encouragement, and celebrate the week you made.' },
] as const;
---
<SiteLayout home title="WeekPact — Good habits. Great company." description="Make a weekly pact with your people. Check in, cheer each other on, and keep showing up together.">
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div>
        <p class="eyebrow">A weekly pact with your people</p>
        <h1 id="hero-title"><span>Good habits<span class="dot">.</span></span><br /><span>Great company<span class="dot">.</span></span></h1>
        <p class="hero-lead">Make a weekly pact with your people. Check in, cheer each other on, and keep showing up together.</p>
        <div class="hero-actions">
          <a class="button" href="/open/">Start your crew <HugeIcon name="arrowUpRight01" size={20} /></a>
          <a class="text-link" href="#how-it-works">See how it works <HugeIcon name="arrowDown01" size={19} /></a>
        </div>
        <p class="hero-proof caption"><HugeIcon name="sparkles" size={17} /> Small steps. Shared wins.<span class="rule"></span></p>
      </div>
      <div class="phone-stage">
        <div class="phone" aria-label="WeekPact running on an iPhone, with a fictional example crew">
          <div class="phone-screen">
            <img id="app-screen" src="/screenshots/home.png" width="1170" height="2532" alt="The current WeekPact home screen: Early Birds crew, recent check-in, crew streak, and today's pacts." fetchpriority="high" />
            <span class="phone-time" aria-hidden="true">9:41</span><span class="island" aria-hidden="true"></span><span class="phone-status" aria-hidden="true">▮▮▮ ▰</span>
          </div>
        </div>
        <div class="screen-switch" role="group" aria-label="Preview app screens">
          <button type="button" data-screen="home" aria-pressed="true">Your week</button>
          <button type="button" data-screen="crew" aria-pressed="false">Your crew</button>
        </div>
        <p class="demo-caption caption">Real app screens · Example crew</p>
      </div>
    </section>

    <section class="features container" aria-labelledby="features-title">
      <p class="eyebrow">Inside the app</p>
      <h2 id="features-title">What a week looks like<span class="dot">.</span></h2>
      <div class="feature-grid">
        {features.map(feature => (
          <article class="surface surface--card feature" style={`--fill:${feature.tint}`}>
            <span class="icon-tile"><HugeIcon name={feature.icon} size={26} /></span>
            <h3>{feature.title}</h3>
            <p>{feature.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="how container" id="how-it-works" aria-labelledby="how-title">
      <p class="eyebrow">How it works</p>
      <h2 id="how-title">A little pact<span class="dot">.</span> A better week<span class="dot" style="color:var(--sky)">.</span></h2>
      <p class="how-lead">Three short steps, and the rest is just showing up.</p>
      <ol class="steps">
        {steps.map((step, index) => (
          <li class="surface surface--card step" style={`--fill:${step.tint}`}>
            <div class="step-head">
              <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
              <HugeIcon name={step.icon} size={26} />
            </div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="close container" aria-labelledby="close-title">
      <div class="surface surface--dark surface--card close-card">
        <h2 id="close-title">Your next good week<br />starts together<span class="dot">.</span></h2>
        <p>Bring your people. Make a little progress together.</p>
        <a class="button" href="/open/">Start your crew <HugeIcon name="arrowUpRight01" size={20} /></a>
      </div>
    </section>
  </main>
</SiteLayout>
<script>
  const params = new URLSearchParams(location.search);
  if (params.has('invite')) location.replace(`/invite/${location.search}`);
  const screen = document.querySelector<HTMLImageElement>('#app-screen');
  document.querySelectorAll<HTMLButtonElement>('[data-screen]').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-screen]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      const selected = button.dataset.screen ?? 'home';
      if (screen) {
        screen.src = `/screenshots/${selected}.png`;
        screen.alt = selected === 'crew' ? 'The expanded crew list with full names and motivating Nudge buttons.' : "The current WeekPact home screen: Early Birds crew, recent check-in, crew streak, and today's pacts.";
      }
    });
  });
</script>
